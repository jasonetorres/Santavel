APP_NAME="Call Santa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# No database is required for the phone line. SQLite lets
# `php artisan migrate --force` succeed on Laravel Cloud before a database
# resource is attached. Wishes are stored in the cache, not in this database.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Cookie sessions and the file cache avoid a sessions table and a cache table.
# Attach a Laravel Cloud cache and set CACHE_STORE to the injected value
# before the stream if wishes must survive a restart or more than one instance.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Provider keys. Never expose these in the browser. The phone page calls
# this app, and this app calls OpenAI and ElevenLabs.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

ELEVENLABS_API_KEY=
# Voice used on the 2025 stream. Replace it if that voice has been removed.
ELEVENLABS_VOICE_ID=1wg2wOjdEWKA7yQD8Kca
ELEVENLABS_MODEL=eleven_flash_v2_5

# Shared secret for the donation wish inbox. Generate a long random string.
# Donation webhooks and the stream desk send it as Authorization: Bearer.
SANTA_WISH_WEBHOOK_SECRET=
